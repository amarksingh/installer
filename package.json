{
  "name": "@ostro/installer",
  "version": "1.0.6",
  "description": "Official CLI installer for the OstroJS framework",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "ostro": "build/index.js"
  },
  "files": [
    "build",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "dependencies": {
    "@ostro/console": "^1.0.5",
    "@ostro/support": "^1.2.1"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json && chmod +x build/index.js",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "engineStrict": true,
  "preferGlobal": true,
  "keywords": [
    "ostro",
    "ostrojs",
    "framework",
    "installer",
    "cli",
    "scaffold",
    "generator"
  ],
  "author": "OstroJS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ostrojs/installer.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/installer/issues"
  },
  "homepage": "https://github.com/ostrojs/installer#readme",
  "devDependencies": {
    "jest": "^30.5.1",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
